# ═══════════════════════════════════════════════════════════════════════════════
# Foreman — environment
#
#   cp .env.example .env    then fill in the three REQUIRED values below.
#
# Every variable here is validated at boot by src/server/env.ts: a bad value stops
# the worker immediately and, in production, stops the web process too. Defaults in
# brackets are what src/server/config.ts uses when the variable is unset.
# Deployment guidance: docs/DEPLOYMENT.md · Security: docs/SECURITY.md
# ═══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────────────────────────
# PostgreSQL 14+. Local (Homebrew): createdb ai_staffing_agency
# Production: add sslmode=require (or verify-full) and connection_limit — see DEPLOYMENT.md § Pooling.
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/ai_staffing_agency?schema=public&options=-c%20TimeZone%3DUTC"

# Session signing key. Generate one — an empty value fails boot:   openssl rand -base64 32
# Rotating it signs every user out. Put the old value in AUTH_SECRET_PREVIOUS for a grace period.
AUTH_SECRET=""

# AES-256-GCM key for the org credentials vault. Must be base64 that decodes to exactly 32 bytes:
#   openssl rand -base64 32
# WARNING: losing or rotating this key makes every stored customer credential unreadable. Escrow it
# separately from your database backups. See docs/DEPLOYMENT.md § Key rotation.
CREDENTIAL_ENCRYPTION_KEY=""

# ── URLs and proxies ────────────────────────────────────────────────────────────
# Public origin. REQUIRED in production and must be https. NEXTAUTH_URL is accepted as an alias.
# AUTH_URL="https://app.example.com"
# Only set when a proxy in front of the app rewrites Host/X-Forwarded-*; AUTH_URL alone is safer.
AUTH_TRUST_HOST=true
# Number of reverse proxies whose X-Forwarded-For entries are trusted for rate limiting [1 in prod, 0 in dev].
# TRUSTED_PROXY_HOPS=1
# Extra hosts allowed to post Server Actions (read by next.config.ts) — comma separated, host only.
# SERVER_ACTIONS_ALLOWED_ORIGINS="app.example.com"
# Must be identical across web instances and builds, or Server Action payloads fail to decrypt:
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── Key rotation (optional, both accept the previous value during a rollout) ─────
# AUTH_SECRET_PREVIOUS=""
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""

# ── Executor / worker ───────────────────────────────────────────────────────────
# Runs are always executed by the separate worker process (`npm run worker`).
# "inline" only tells `npm run dev` to start a worker alongside the web server; "off" = a dedicated
# `npm run worker` process does (production default). src/worker.ts ignores this and always executes.
# EXECUTOR_MODE=inline
# EXECUTOR_DISABLED=true        # deprecated alias for EXECUTOR_MODE=off
# EXECUTOR_POLL_MS=1000         # queue poll interval [1000]
# EXECUTOR_CONCURRENCY=2        # runs in flight per executor process [2]
# EXECUTOR_STALE_LOCK_MS=120000 # a RUNNING run with no heartbeat for this long is recovered [120000]
# SCHEDULER_TICK_MS=30000       # how often due scheduled workers are queued [30000]
# How long a stopping worker waits for in-flight runs before handing their leases back [20000].
# Keep it BELOW the orchestrator's termination grace period (Docker/K8s default 30 s).
# SHUTDOWN_GRACE_MS=20000
# SERVICE_NAME=worker           # logger field distinguishing web from worker [web]

# ── Sign-up and demo access ─────────────────────────────────────────────────────
# open = anyone can create a workspace · invite = SIGNUP_INVITE_CODE required · closed = invitations only.
# Defaults to "open" in dev and "closed" in production.
# SIGNUP_MODE=closed
# SIGNUP_INVITE_CODE=""         # ≥ 12 chars; required when SIGNUP_MODE=invite
# DEMO_MODE=true                # pre-fills the demo credentials on the sign-in page
# Required before `npm run db:seed:demo` will touch a production database. The demo workspace
# ships a publicly documented password — never set this on a deployment with real customers.
# ALLOW_DEMO_SEED=true

# ── Model providers ─────────────────────────────────────────────────────────────
# With no keys set the app runs in clearly-badged "Simulated mode" on a deterministic mock provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Override which model serves each tier: "<provider>:<model-id>"
# MODEL_TIER_FAST=anthropic:claude-haiku-4-5
# MODEL_TIER_STANDARD=anthropic:claude-sonnet-5
# MODEL_TIER_REASONING=anthropic:claude-opus-5
# Force the mock provider even when keys exist (demos, load tests).
# FORCE_SIMULATED=true

# ── Tools ───────────────────────────────────────────────────────────────────────
# Real web search (https://tavily.com). Without it, web_search returns simulated results.
TAVILY_API_KEY=

# ── Limits and spend ────────────────────────────────────────────────────────────
# PLATFORM_DEFAULT_MONTHLY_BUDGET_USD=25   # per org, when Organization.monthlyBudgetUsd is null [25]
# PLATFORM_MAX_COST_PER_RUN_USD=5          # ceiling a blueprint's own limit is clamped to [5]
# PLATFORM_MAX_TOOL_CALLS_PER_RUN=60       # [60]
# PLATFORM_MAX_RUN_DURATION_SEC=1800       # [1800]
# USAGE_MARGIN_MULTIPLIER=1.4              # billable = cost × multiplier [1.4]
# Development escape hatch only — rejected at boot when NODE_ENV=production.
# RATE_LIMIT_DISABLED=true

# ── Retention (enforced by the worker's maintenance sweep) ──────────────────────
# RETENTION_TRACE_DAYS=30       # clear model prompts/responses and step payloads after N days [30]
# RETENTION_EVENTS_DAYS=365     # delete activity + security events after N days [365]

# ── Observability ───────────────────────────────────────────────────────────────
# LOG_LEVEL=info                # debug | info | warn | error [info]
# LOG_FORMAT=json               # json | pretty [json in production, pretty otherwise]
# APP_VERSION=                  # git sha baked in at image build; reported by /api/health
# PRISMA_LOG=query              # NEVER in production: logs SQL including parameters
