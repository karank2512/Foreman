# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
# Foreman — configuration
#
# Most people only ever touch ONE line here: a model provider key (section 1). Everything else is optional.
#
#   No key         → Simulated mode. The whole product works end to end on a built-in, deterministic mock model
#                    and simulated tools, badged "Simulated" in the UI. Free; nothing leaves your machine.
#   One key        → real model calls, billed to YOUR provider account. There is no hosted Foreman: your key
#                    stays in this file and is sent only to that provider.
#
# Docker:  cp .env.example .env · set a key (optional) · docker compose up · open http://localhost:3000
#          The secrets and the database below are handled for you; the stack's defaults live in docker-compose.yml.
# Node:    npm run setup:local writes .env for you (generated secrets, local defaults) and never overwrites a value.
#
# Every variable is validated at boot by src/server/env.ts: a bad value stops the worker immediately and, in
# production, stops the web process too. Defaults in [brackets] apply when a variable is unset.
# Running it for other people: docs/DEPLOYMENT.md · Security: docs/SECURITY.md
# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

# ── 1. Model provider: set ONE, or none for Simulated mode ─────────────────────────────────────────────────────
# If several are set, the first in this order serves every tier: Anthropic, OpenAI, Google.
# Check a key and its model ids (one tiny real call per model the key would serve, up to three):
#   Node: npm run smoke:live · Docker: docker compose run --rm --no-deps --entrypoint node web dist/smoke-live.cjs
# A key exported in your shell wins over this file (Node path). The demo workspace never spends a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Live web search for workers (https://tavily.com). Without it, web_search returns simulated results. A workspace
# can also store its own key under Settings → Tool credentials.
TAVILY_API_KEY=

# ── 2. Models and spend (optional) ─────────────────────────────────────────────────────────────────────────────
# Pick the model behind each tier: "<provider>:<model-id>" (anthropic | openai | google). The provider's key must
# be set. Defaults (fast / standard / reasoning): anthropic claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5,
# openai gpt-6-luna / gpt-6.1-sol / gpt-6.1-sol, google gemini-3.5-flash-lite / gemini-3.8-flash / gemini-3.8-flash.
# MODEL_TIER_FAST=anthropic:claude-haiku-4-5
# MODEL_TIER_STANDARD=anthropic:claude-sonnet-5
# MODEL_TIER_REASONING=anthropic:claude-opus-5
# Use the mock provider even though a key is set (rehearse without spending).
# FORCE_SIMULATED=true
#
# Guard rails on REAL provider spend (Simulated runs cost nothing and are never blocked). A workspace owner can
# change their own monthly budget under Settings → Workspace.
# PLATFORM_DEFAULT_MONTHLY_BUDGET_USD=25   # per workspace per month, when it has not set its own [25]
# PLATFORM_MAX_COST_PER_RUN_USD=5          # ceiling a worker's own per-run limit is clamped to [5]
# PLATFORM_MAX_TOOL_CALLS_PER_RUN=60       # [60]
# PLATFORM_MAX_RUN_DURATION_SEC=1800       # [1800]

# ── 3. Database and secrets ────────────────────────────────────────────────────────────────────────────────────
# Docker: leave these alone. The stack uses its own Postgres, and generates AUTH_SECRET and
# CREDENTIAL_ENCRYPTION_KEY on first boot (kept in the "secrets" volume). A value you put here wins.
# Node:   `npm run setup:local` fills them in (copying the Docker stack's, if it has run). By hand:
#         openssl rand -base64 32 (once for each secret). Values here also override the Docker stack's.

# PostgreSQL 14+. Node path only (Docker always uses its own database). This default is a `foreman_dev` database on
# the Docker Postgres (`docker compose up -d db` publishes it on localhost:5433); `npm run setup:dev` creates it,
# and it is kept apart from the Docker app's own `foreman` database.
# Keep the TimeZone option: the app stores UTC and compares timestamps against the database clock.
# Production: add sslmode=require (or verify-full) and connection_limit — see docs/DEPLOYMENT.md § Database.
DATABASE_URL="postgresql://app:app@localhost:5433/foreman_dev?schema=public&options=-c%20TimeZone%3DUTC"

# Signs session cookies. At least 32 characters in production. Rotating it signs every user out; put the old
# value in AUTH_SECRET_PREVIOUS for a grace period.
AUTH_SECRET=""

# AES-256-GCM key for the workspace credentials vault: base64 that decodes to exactly 32 bytes.
# WARNING: losing or changing this key makes every stored credential unreadable. Back it up separately from the
# database. See docs/DEPLOYMENT.md § Key rotation.
CREDENTIAL_ENCRYPTION_KEY=""

# Key rotation — both accept the previous value during a rollout.
# AUTH_SECRET_PREVIOUS=""
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=""

# ── 4. Docker stack (docker-compose.yml only) ──────────────────────────────────────────────────────────────────
# WEB_PORT=3000                 # the app is served on http://localhost:$WEB_PORT [3000]
# POSTGRES_PORT=5433            # the database is published on localhost:$POSTGRES_PORT [5433]
# POSTGRES_USER=app             # [app]  — change these before the first `docker compose up`;
# POSTGRES_PASSWORD=app         # [app]    the database volume keeps its original credentials
# POSTGRES_DB=foreman           # [foreman]

# ── 5. Sign-up and the demo workspace ──────────────────────────────────────────────────────────────────────────
# open = anyone who can reach the app can create a workspace · invite = SIGNUP_INVITE_CODE required ·
# closed = invitations only. [open with Docker and in development; closed in any other production deploy]
# SIGNUP_MODE=open
# SIGNUP_INVITE_CODE=""         # ≥ 12 chars; required when SIGNUP_MODE=invite
# Offers "Explore the demo workspace" (Acme Robotics, a publicly known password) on the sign-in page.
# [true with Docker and `npm run setup:local`; off otherwise]. DEMO_MODE=false also stops Docker seeding it.
# DEMO_MODE=true
# Lets `npm run db:seed:demo` touch a NODE_ENV=production database. The Docker stack sets it for its own setup
# job only. Never set it on a deployment with real users.
# ALLOW_DEMO_SEED=true

# ── 6. Public URL and proxies ──────────────────────────────────────────────────────────────────────────────────
# The origin people use to reach the app. Required in production, where it must be https:// — plain http is only
# accepted for localhost, and then the app only answers requests addressed to localhost (DNS-rebinding guard).
# [Docker: http://localhost:$WEB_PORT · npm run dev: http://localhost:<its port>] NEXTAUTH_URL is accepted as an alias.
# AUTH_URL=http://localhost:3000
# Only when a proxy in front of the app rewrites Host / X-Forwarded-*; AUTH_URL alone is safer. [unset]
# AUTH_TRUST_HOST=true
# Reverse proxies whose X-Forwarded-For entries are trusted for rate limiting [1 in production, 0 in development].
# TRUSTED_PROXY_HOPS=1
# Extra hosts allowed to post Server Actions (read at build time by next.config.ts) — comma separated, host only.
# SERVER_ACTIONS_ALLOWED_ORIGINS="app.example.com"
# Must be identical across web instances and builds, or Server Action payloads fail to decrypt:
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── 7. Executor / worker ───────────────────────────────────────────────────────────────────────────────────────
# Runs are always executed by the separate worker process (`npm run worker`; `npm run dev` starts web + worker).
# "inline" only tells `npm run dev` to start a worker alongside the web server; "off" starts the web server alone
# (production default). src/worker.ts ignores this and always executes.
# EXECUTOR_MODE=inline
# EXECUTOR_DISABLED=true        # deprecated alias for EXECUTOR_MODE=off
# EXECUTOR_POLL_MS=1000         # queue poll interval [1000]
# EXECUTOR_CONCURRENCY=2        # runs in flight per worker process [2]
# EXECUTOR_STALE_LOCK_MS=120000 # a RUNNING run with no heartbeat for this long is recovered [120000]
# SCHEDULER_TICK_MS=30000       # how often due scheduled workers are queued [30000]
# How long a stopping worker waits for in-flight runs before handing their leases back [20000].
# Keep it BELOW the orchestrator's termination grace period (Docker/K8s default 30 s).
# SHUTDOWN_GRACE_MS=20000
# SERVICE_NAME=worker           # logger field distinguishing web from worker [web]

# ── 8. Retention (enforced by the worker's maintenance sweep) ──────────────────────────────────────────────────
# RETENTION_TRACE_DAYS=30       # clear model prompts/responses and step payloads after N days [30]
# RETENTION_EVENTS_DAYS=365     # delete activity + security events after N days [365]

# ── 9. Observability and development ───────────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info                # debug | info | warn | error [info]
# LOG_FORMAT=json               # json | pretty [json in production, pretty otherwise]
# APP_VERSION=                  # build identifier reported by /api/health [Docker: local]
# PRISMA_LOG=query              # NEVER in production: logs SQL including parameters
# Development escape hatch only — rejected at boot when NODE_ENV=production.
# RATE_LIMIT_DISABLED=true
