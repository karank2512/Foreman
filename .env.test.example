# Copy to .env.test for `npm test`. Tests always run in Simulated mode against a dedicated database.
# With the Docker database (`docker compose up -d db`), create it once:
#   docker compose exec db createdb -U app foreman_test
# With your own Postgres: createdb foreman_test, and point DATABASE_URL at it.
# tests/setup/env.ts additionally forces FORCE_SIMULATED, EXECUTOR_MODE=off and RATE_LIMIT_DISABLED,
# and clears every provider key, so a suite can never reach a real API or execute a run in the background.
# Keep this file in sync with .env.example and with .github/workflows/ci.yml.

# Must contain "_test": tests/setup/global-setup.ts refuses to run migrations against anything else.
DATABASE_URL="postgresql://app:app@localhost:5433/foreman_test?schema=public&options=-c%20TimeZone%3DUTC"

AUTH_SECRET="test-secret-not-used-in-production-0123456789"
AUTH_TRUST_HOST=true

# Fixed throwaway key so the credentials-vault suites are reproducible. Test data only —
# generate a real one for any other environment:   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="dGVzdC1vbmx5LWtleS1kby1ub3QtdXNlLWluLXByb2Q="

# Runs are executed by calling executeRun() directly; no background loop in tests.
EXECUTOR_MODE=off
EXECUTOR_DISABLED=true
