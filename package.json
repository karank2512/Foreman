{
  "name": "foreman",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/generate-migrations-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "start:web": "node .next/standalone/server.js",
    "migrations:manifest": "node scripts/generate-migrations-manifest.mjs",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.cjs",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy",
    "setup:dev": "prisma migrate deploy && tsx prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "dev:web": "next dev"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.102",
    "@ai-sdk/google": "^2.0.97",
    "@ai-sdk/openai": "^2.0.127",
    "@prisma/client": "^6.19.3",
    "ai": "^5.0.262",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@ai-sdk/provider-utils": {
      "undici": "^6.28.1"
    },
    "next": {
      "postcss": "^8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
